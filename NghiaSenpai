local infO2Toggle = false
local noLavaToggle = false
local noPressureToggle = false

pcall(function()
	local rm = getrawmetatable(game)
	if setreadonly then setreadonly(rm, false) end
	local oldNc = rm.__namecall

	rm.__namecall = newcclosure(function(self, ...)
		local method = getnamecallmethod()
		if (method == "FireServer" or method == "InvokeServer") then
			local name = tostring(self):lower()
			if infO2Toggle and (name:find("o2") or name:find("oxy") or name:find("drown") or name:find("breath") or name:find("water")) then
				return nil
			end
			if noLavaToggle and (name:find("lava") or name:find("heat") or name:find("burn") or name:find("fire") or name:find("temperature")) then
				return nil
			end
			if noPressureToggle and (name:find("pressure") or name:find("depth") or name:find("crush") or name:find("sink")) then
				return nil
			end
		end
		return oldNc(self, ...)
	end)
	if setreadonly then setreadonly(rm, true) end
end)

