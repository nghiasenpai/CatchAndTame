-- 4. HÀM QUÉT PHẨM CẤP THÚ
local function checkRarity(model)
	local strMatch = ""
	strMatch = strMatch .. " " .. model.Name:lower()
	
	pcall(function()
		for attrName, attrVal in pairs(model:GetAttributes()) do
			strMatch = strMatch .. " " .. tostring(attrName):lower() .. " " .. tostring(attrVal):lower()
		end
	end)
	
	pcall(function()
		for _, child in ipairs(model:GetChildren()) do
			strMatch = strMatch .. " " .. child.Name:lower()
			if child:IsA("StringValue") then
				strMatch = strMatch .. " " .. tostring(child.Value):lower()
			end
		end
	end)
	
	if strMatch:find("divine") then return "DIVINE", Color3.fromRGB(255, 215, 0) end
	if strMatch:find("boss") then return "BOSS", Color3.fromRGB(255, 30, 30) end
	if strMatch:find("mythic") or strMatch:find("mythical") then return "MYTHICAL", Color3.fromRGB(160, 32, 240) end
	
	return nil, nil
end

